#!/usr/bin/env bash
set -euo pipefail

DIARY_DIR="${DIARY_DIR:-$HOME/.diary}"
DIARY_EDITOR="${DIARY_EDITOR:-nvim}"

# Trailing slashes make path comparisons awkward; keep "/" intact.
if [ -n "${DIARY_DIR%/}" ]; then
  DIARY_DIR="${DIARY_DIR%/}"
fi

# Explicit names so the output does not depend on LC_TIME.
months=(January February March April May June July August September October November December)

usage() {
  cat >&2 <<'EOF'
Usage: diary <command>

Commands:
  new             Create or edit an entry for the current minute
  render          Open a read-only markdown view of all entries
  render --stdout Print the generated markdown to stdout
EOF
}

ensure_repo() {
  if [ ! -d "$DIARY_DIR" ]; then
    mkdir -p "$DIARY_DIR"
  fi

  if [ ! -e "$DIARY_DIR/.git" ]; then
    printf 'diary: initializing repository at %s\n' "$DIARY_DIR" >&2
    git -C "$DIARY_DIR" init -q -b main
  fi
}

has_content() {
  local file="$1"
  [ -f "$file" ] && grep -q '[^[:space:]]' "$file"
}

discard_entry() {
  local file="$1"
  local dir="$2"

  if [ -e "$file" ]; then
    rm -f "$file"
  fi

  # Remove the date directories while they are empty, stopping at the diary root.
  while [ "$dir" != "$DIARY_DIR" ] && [ -d "$dir" ]; do
    if ! rmdir "$dir" 2>/dev/null; then
      break
    fi
    dir="${dir%/*}"
  done
}

create_entry() {
  ensure_repo

  local now year month day hhmm
  now="$(date +'%Y/%m/%d/%H%M')"
  IFS=/ read -r year month day hhmm <<< "$now"

  local date_dir="$DIARY_DIR/$year/$month/$day"
  local file="$date_dir/$hhmm.md"

  if [ -e "$file" ]; then
    printf 'diary: opening existing entry %s\n' "$file" >&2
  fi

  mkdir -p "$date_dir"

  if ! "$DIARY_EDITOR" "$file"; then
    if ! has_content "$file"; then
      discard_entry "$file" "$date_dir"
    fi
    printf 'diary: editor exited with an error; nothing committed.\n' >&2
    exit 1
  fi

  if ! has_content "$file"; then
    discard_entry "$file" "$date_dir"
    printf 'diary: empty entry discarded; nothing committed.\n' >&2
    exit 0
  fi

  local hh="${hhmm:0:2}"
  local mm="${hhmm:2:2}"

  git -C "$DIARY_DIR" add -A

  if git -C "$DIARY_DIR" diff --cached --quiet; then
    printf 'No diary changes to commit.\n' >&2
    return 0
  fi

  if ! git -C "$DIARY_DIR" commit -q -m "diary: $year-$month-$day $hh:$mm"; then
    printf 'diary: failed to commit entry. Press Enter to close.' >&2
    read -r _ || true
    exit 1
  fi

  printf 'diary: committed %s-%s-%s %s:%s\n' "$year" "$month" "$day" "$hh" "$mm" >&2
}

render_markdown() {
  local entries=()

  if [ -d "$DIARY_DIR" ]; then
    local relative
    while IFS= read -r relative; do
      entries+=("$relative")
    done < <(
      cd "$DIARY_DIR" || exit 0
      find . -type f -regextype posix-extended \
        -regex '\./[0-9]{4}/[0-9]{2}/[0-9]{2}/[0-9]{4}\.md' |
        sed 's|^\./||' |
        LC_ALL=C sort -r
    )
  fi

  if [ "${#entries[@]}" -eq 0 ]; then
    printf 'No diary entries yet.\n'
    return 0
  fi

  local previous_year="" previous_month="" previous_day=""
  local year month day filename hhmm month_name entry_file
  for relative in "${entries[@]}"; do
    IFS=/ read -r year month day filename <<< "$relative"
    hhmm="${filename%.md}"

    if [ "$year" != "$previous_year" ]; then
      printf '# %s\n\n' "$year"
      previous_year="$year"
      previous_month=""
      previous_day=""
    fi

    if [ "$month" != "$previous_month" ]; then
      month_name="${months[$((10#$month - 1))]}"
      printf '## %s %s\n\n' "$month_name" "$year"
      previous_month="$month"
      previous_day=""
    fi

    if [ "$day" != "$previous_day" ]; then
      printf '### %s-%s-%s\n\n' "$year" "$month" "$day"
      previous_day="$day"
    fi

    printf '#### %s:%s\n' "${hhmm:0:2}" "${hhmm:2:2}"

    entry_file="$DIARY_DIR/$year/$month/$day/$filename"
    cat -- "$entry_file"
    if [ -n "$(tail -c 1 -- "$entry_file")" ]; then
      printf '\n'
    fi
    printf '\n'
  done
}

render_diary() {
  local mode="${1:-}"

  if [ "$mode" = "--stdout" ]; then
    render_markdown
    return 0
  fi

  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/diary.XXXXXX.md")"
  DIARY_RENDER_TMP="$tmp"
  trap 'rm -f "$DIARY_RENDER_TMP"' EXIT

  render_markdown > "$tmp"

  "$DIARY_EDITOR" -R -M -n -c 'setlocal filetype=markdown' "$tmp"
}

case "${1:-}" in
  new)
    create_entry
    ;;
  render)
    shift
    case "${1:-}" in
      "")
        render_diary
        ;;
      --stdout)
        render_diary --stdout
        ;;
      *)
        printf 'diary: unknown render option: %s\n' "$1" >&2
        usage
        exit 1
        ;;
    esac
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    printf 'diary: unknown command: %s\n' "$1" >&2
    usage
    exit 1
    ;;
esac
